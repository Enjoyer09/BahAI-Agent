# ==========================================
# bahAI — Environment Configuration
# Copy to .env and fill in your values
# ==========================================

# === Server ===
PORT=3001
NODE_ENV=development
LOCAL_MODE=true                    # Set to 'true' for local single-user mode (no DB needed)
HOST=127.0.0.1                     # Local mode should remain loopback-only

# === Security ===
JWT_SECRET=your-secure-random-secret-here    # REQUIRED in production. Min 32 chars.
DEMO_LOGIN_ENABLED=false           # Never enable on public production deployments
ENABLE_SERVER_TOOLS=false          # Opt-in for non-admin cloud workspace/terminal access
ACCESS_TOKEN_EXPIRY=15m            # P1: Short-lived access token (default: 15m)
REFRESH_TOKEN_EXPIRY=7d            # P1: Refresh token lifetime (default: 7d)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001  # Comma-separated list of allowed CORS origins

# === Database (optional in LOCAL_MODE) ===
# DATABASE_URL=postgres://user:password@localhost:5432/bahai
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=YourStrongAdminPassword123!

# === AI Provider ===
# FreeModel.dev — Recommended (free GPT-5.5, Claude Opus, o3 access)
# Sign up: https://freemodel.dev — get API key from dashboard
# Supports both Codex (Responses API) and Chat Completions wire format
OPENAI_API_KEY=YOUR_FREEMODEL_API_KEY
OPENAI_BASE_URL=https://api.freemodel.dev/v1
OPENAI_MODEL=gpt-5.5                            # or: claude-sonnet-4, claude-opus-4, o3, gpt-5

# Alternative: OpenRouter (paid, many models)
# OPENAI_API_KEY=sk-or-v1-your-key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-sonnet-4.5

# === Auto Mode (Smart Router) ===
AUTO_FAST_MODEL=gpt-5.5                          # FreeModel: fast for quick tasks
AUTO_SMART_MODEL=claude-sonnet-4                  # FreeModel: smart for complex tasks

# === Web Chat Routing (BahAI Cloud) ===
# Web məhsulu ChatGPT-stili sadə chat kimidir; model seçimini UI-dan gizlədib arxa planda router idarə edir.
WEB_CHAT_FAST_MODEL=gpt-5.5                      # sadə ümumi sorğular
WEB_CHAT_SMART_MODEL=claude-sonnet-4             # daha dərin reasoning / uzun cavablar
WEB_CHAT_VISION_MODEL=gpt-5.5                    # şəkil / screenshot / GUI observation
WEB_CHAT_CODE_MODEL=qwen/qwen3-coder:free        # web chat içində kod/refactor sualları

# === OmniRoute Gateway (optional, web cloud control plane) ===
# Aktivdirsə web chat auto-routing əvvəlcə OmniRoute gateway-ə gedir.
# Gateway provider failover, paylama və health siyasətini öz içində idarə edə bilər.
# OMNIROUTE_ENABLED=true
# OMNIROUTE_BASE_URL=https://your-omniroute-host/v1
# OMNIROUTE_API_KEY=your-omniroute-key
# OMNIROUTE_MODEL=gpt-5.5                        # optional shared default model

# === NVIDIA Build / NIM (optional cloud fallback) ===
# Model ID-lərini https://build.nvidia.com/models səhifəsindəki API nümunəsindən olduğu kimi götürün.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_GENERAL_MODEL=provider/general-model-id
# NVIDIA_FAST_MODEL=provider/fast-model-id
# NVIDIA_SMART_MODEL=provider/reasoning-model-id
# NVIDIA_CODE_MODEL=provider/code-model-id
# NVIDIA_VISION_MODEL=provider/vision-model-id
# NVIDIA_FALLBACK_MODELS=provider/fallback-1,provider/fallback-2

# === Ollama (local models) ===
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_DEFAULT_MODEL=gemma4:12b
# DESKTOP_LOCAL_DEFAULT_MODEL=gemma4:12b

# === Freebuff2API local proxy (optional) ===
# BahAI startup scripts automatically read these from .env / .env.local
# and try to launch Freebuff quietly in background.
# FREEBUFF_AUTO_START=true
# FREEBUFF_BASE_URL=http://127.0.0.1:8080/v1
# FREEBUFF_START_CMD=python3 /absolute/path/to/Freebuff2API/app.py
# FREEBUFF_HEALTH_URL=http://127.0.0.1:8080/v1/models

# === Multi-Provider Pool (optional — JSON array) ===
# AI_PROVIDER_POOL='[{"id":"ollama","baseURL":"http://localhost:11434/v1","apiKey":"ollama","model":"qwen2.5-coder:7b"},{"id":"openrouter","baseURL":"https://openrouter.ai/api/v1","apiKey":"sk-or-...","model":"anthropic/claude-sonnet-4.5"}]'

# === OpenRouter Free Fallback Chain (optional) ===
# Web chat auto-routing və desktop auto-rejim OpenRouter-a yalnız bu açar
# təyin olunduqda müraciət edir (və ya OPENAI_API_KEY "sk-or-" ilə başlayırsa).
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default artıq budur
# Hər model ayrıca failover namizədi kimi sıraya düşür; boş qaldıqda task-a
# uyğun default əlavə olunur (mətn: meta-llama/llama-3.3-70b-instruct:free,
# vision: google/gemini-2.0-flash-exp:free).
# OPENROUTER_FALLBACK_MODELS='deepseek/deepseek-v4-flash:free,qwen/qwen3-coder:free'

# === Agent Behavior ===
MAX_AGENT_STEPS=6                  # Max tool-call loops per request (default: 6)
LLM_TIMEOUT_MS=180000              # LLM response timeout in ms (default: 3min, desktop/agent requests)
LLM_TIMEOUT_CHAT=20000             # Web chat per-attempt timeout (default: 20s, hard cap 20s)
VISION_LLM_TIMEOUT_MS=30000        # Vision (image) requests get a longer per-attempt floor (default: 30s)
PROVIDER_COOLDOWN_MS=20000         # Cooldown after provider failure (default: 20s)
# BAHAI_DEBUG_EVENTS=1             # Failover zamanı real provider xətasını SSE debug hadisəsi kimi ver (yalnız lokal debaq üçün!)

# === File System Access ===
ALLOWED_DIRECTORIES=/Users/YOU/Documents/GitHub,/tmp   # Comma-separated allowed paths
WORKSPACE_ROOT=/Users/YOU/Documents/bahai_workspace    # Default workspace root

# === Google OAuth (optional) ===
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# === Rate Limiting ===
API_RATE_WINDOW_MS=60000           # Rate limit window (default: 60s)
API_RATE_MAX=300                   # Max requests per window (default: 300)

# === CSP (Content Security Policy) ===
DISABLE_CSP=false                  # Keep false in production

# === GUI Browser (optional) ===
# GUI_BROWSER_CDP_URL=http://127.0.0.1:9222
# GUI_BROWSER_MODE=cdp

# === GUI Visual Grounding (Agent-S style) ===
# Uses vision model to locate UI elements by description on screenshots.
# Defaults to OPENAI_API_KEY/OPENAI_BASE_URL if not set separately.
# GROUNDING_API_KEY=same-as-openai-key        # Defaults to OPENAI_API_KEY
# GROUNDING_BASE_URL=https://api.freemodel.dev/v1
GROUNDING_MODEL=gpt-5.5                        # Must support image input (vision)
# REFLECTION_MODEL=gpt-5.5                    # For action reflection (screenshot diff)

# === ElevenLabs Voice (optional) ===
# ELEVENLABS_API_KEY=your-elevenlabs-key
# ELEVENLABS_AGENT_ID=your-agent-id

# === Fish Audio TTS — Voice Mode (free tier, s2.1-pro-free) ===
# Get API key: https://fish.audio/app/api-keys/
# Free until August 31, 2026 — unlimited usage under Fair Use Policy
# FISH_API_KEY=your-fish-audio-api-key
# FISH_TTS_MODEL=s2.1-pro-free                  # Default free model
# FISH_TTS_VOICE_ID=                            # Optional: custom voice clone ID
