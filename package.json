{
  "name": "ibahora-monorepo",
  "version": "1.0.0",
  "private": true,
  "bin": {
    "bahai-agent": "./bin/cli.js"
  },
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "build": "npm install --prefix backend && npm install --prefix frontend && npm run build --prefix frontend",
    "start": "node backend/index.js",
    "local": "node bin/cli.js",
    "smoke:gui": "node scripts/gui-smoke.js",
    "smoke:prod": "node scripts/prod-smoke.js",
    "smoke:desktop": "node scripts/desktop-smoke.js",
    "smoke:electron": "node scripts/electron-smoke.js",
    "smoke:prod:checkpoint": "node scripts/prod-smoke.js --checkpoint",
    "check:harness": "node scripts/check-harness.js",
    "chrome:debug": "bash scripts/start-debug-chrome.sh",
    "start:gui": "bash scripts/start-bahai-gui.sh",
    "launch:gui": "bash scripts/launch-bahai-gui.sh",
    "desktop": "npm run build --prefix frontend && npm run desktop:dev",
    "desktop:dev": "cd electron && npm start",
    "desktop:build": "npm run build --prefix frontend && cd electron && npm run build:mac",
    "desktop:install": "cd electron && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
