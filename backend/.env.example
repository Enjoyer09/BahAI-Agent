# ============================================================
# BahAI Agent — Backend environment (Railway / local)
# Copy to `.env` and fill in. Railway reads these as project
# environment variables.
# ============================================================

# --- Core ---
NODE_ENV=production
PORT=3001
DATABASE_URL=postgres://user:pass@host:5432/db
JWT_SECRET=change-me
ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# --- OmniRoute: OpenAI-compatible /v1 gateway (web chat primary) ---
# REQUIRED for cloud web chat. When true and OMNIROUTE_BASE_URL is set,
# buildProviderCandidates makes OmniRoute the primary provider for web_chat.
OMNIROUTE_ENABLED=true
OMNIROUTE_API_KEY=your-omniroute-key
OMNIROUTE_BASE_URL=https://omniroute-bahai-smart-production.up.railway.app
OMNIROUTE_MODEL=auto
# Fallback model chain tried after `auto` (comma or newline separated)
OMNIROUTE_FALLBACK_MODELS=auto,gpt-5.5,anthropic/claude-sonnet-4.5

# --- Circuit breaker protecting upstream providers (esp. OmniRoute) ---
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_MS=30000
BREAKER_HALF_OPEN_MAX=1

# --- Per-user job quota (admission guard) ---
JOB_MAX_ACTIVE_PER_USER=5

# --- Worker concurrency (separate worker process) ---
WORKER_CONCURRENCY=12
WORKER_LEASE_MS=120000
WORKER_HEARTBEAT_MS=15000
WORKER_PER_USER_ACTIVE=1
WORKER_POLL_MS=250

# --- Admin ops endpoint guard (GET /api/admin/ops) ---
# If unset in production the endpoint returns 403. Set to a strong secret and
# pass it as `x-admin-token` header.
ADMIN_OPS_TOKEN=

# --- STT (Voice Mode speech-to-text, /api/stt) ---
# DISABLED until both STT_BASE_URL and STT_API_KEY are set. When set, Voice Mode
# records audio client-side (MediaRecorder) and transcribes via this
# OpenAI-compatible Whisper endpoint (POST /audio/transcriptions). Fixes the old
# client-only Web Speech `tr-TR` bug for the Azerbaijani agent. If unconfigured,
# the client falls back to the Web Speech API (az-AZ).
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=your-stt-key
# STT_MODEL=whisper-1
# STT_DEFAULT_LANG=az

# --- Logging ---
# Set true for one-JSON-object-per-line logs (Railway/Datadog friendly).
STRUCTURED_LOGS=true
